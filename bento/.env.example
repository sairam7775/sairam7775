# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server only. Never expose to the browser: it bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — Bento Man (P6).
ANTHROPIC_API_KEY=
# D8: Opus 5 first; switch to claude-sonnet-5 once the eval holds.
BENTO_MAN_MODEL=claude-opus-5
# low | medium | high. Medium is plenty: the reasoning is in the engine.
BENTO_MAN_EFFORT=medium

# Spend ceiling in USD per user per calendar month. A request that would
# cross this is refused before it reaches the model (E2).
BENTO_MONTHLY_SPEND_CAP_USD=20

# Encryption key for booking references, 32 bytes base64.
# Generate with: openssl rand -base64 32
BENTO_BOOKING_REF_KEY=
