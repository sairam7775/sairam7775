# The deployed origin, used to build auth redirect URLs. Leave unset
# locally and it falls back to the request host; set it in production,
# where the host header is a proxy's rather than yours.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server only. Never expose to the browser: it bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# Chat provider: anthropic (default) | gemini. Booking reads stay on Anthropic.
BENTO_MAN_PROVIDER=anthropic
# Anthropic — Bento Man (P6) and the booking reader.
ANTHROPIC_API_KEY=
# Gemini Developer API, server only. Free-tier prompts may be used by Google
# to improve products, so booking text should not go through it in production.
GEMINI_API_KEY=
# Model override. Unset: claude-opus-5 for Anthropic, gemini-3.8-flash for Gemini.
# D8: switch to claude-sonnet-5 only once the eval holds. Every new provider
# must pass scripts/eval-bento-man.ts before use. Every model used needs a
# price in cost.ts (Gemini's are paid-tier rates, so the cap is safe either way).
# BENTO_MAN_MODEL=claude-opus-5
# Gemini only: models to try in order when one is out of quota or overloaded.
# Unset: gemini-3.6-flash,gemini-3.1-flash-lite. "none" turns fallback off.
# BENTO_MAN_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
# Anthropic only: low | medium | high. The reasoning is in the engine.
BENTO_MAN_EFFORT=medium
# Local development without an API key: 1 swaps the model for a keyword
# script (src/lib/bento-man/mock.ts). The tools and engine still run for
# real. Ignored when NODE_ENV is production.
# BENTO_MAN_MOCK=1

# Spend ceilings in USD per calendar month: per user, and for everyone together. A request that would
# cross this is refused before it reaches the model (E2).
BENTO_MONTHLY_SPEND_CAP_USD=20
BENTO_GLOBAL_MONTHLY_SPEND_CAP_USD=50

# Encryption key for booking references, 32 bytes base64.
# Generate with: openssl rand -base64 32
BENTO_BOOKING_REF_KEY=

# Google sign-in. Leave unset until a Google OAuth client exists and the
# Google provider is enabled in Supabase (Authentication → Providers);
# otherwise the button leads to an error page.
# BENTO_GOOGLE_SIGN_IN=1
